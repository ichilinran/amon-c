        "github",
        "pages"
      ],
      "purpose": "Adopt the agreed MIT license for project-owned material and specify rightsholder/scope"
    },
    {
      "path": "licenses.html",
      "targets": [
        "github",
        "pages"
      ],
      "purpose": "Provide a readable notice entry point and links, including SDK source recovery instructions"
    },
    {
      "path": "docs/DEVELOPMENT.md",
      "targets": [
        "github"
      ],
      "purpose": "Document public checkout, checks, build and generated directories"
    },
    {
      "path": ".nojekyll",
      "targets": [
        "pages"
      ],
      "purpose": "Preserve static paths when deploying the generated Pages directory"
    }
