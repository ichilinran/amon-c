      "kind": "sample fetch"
    },
    {
      "from": "src/ui/main.js",
      "to": "examples/analysis/project-21.analysis.json",
      "kind": "legacy-data sample fetch"
    },
    {
      "from": "src/runtime/resources.js",
      "to": "wasm/out/shi-clang.wasm.gz",
      "kind": "compressed Wasm"
    },
    {
      "from": "src/runtime/resources.js",
      "to": "wasm/out/sdk-core.json.gz",
      "kind": "initial SDK"
    },
    {
      "from": "src/runtime/resources.js",
      "to": "wasm/out/sdk-index.json",
      "kind": "SDK lookup"
    },
    {
      "from": "src/runtime/resources.js",
      "to": "wasm/out/sdk.json.gz",
      "kind": "full SDK fallback"
    },
    {
      "from": "index.html",
      "to": "fonts/amon-c-code-subset.woff2",
      "kind": "code display font (OFL-1.1 subset, renamed)"
    },
    {
      "from": "index.html",
      "to": "ogp.png",
      "kind": "Open Graph preview image"
    }
